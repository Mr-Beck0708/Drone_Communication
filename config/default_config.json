{
    "crypto": {
        "kyber_variant": "Kyber768",
        "dilithium_variant": "Dilithium3"
    },
    "communication": {
        "session_timeout": 3600,
        "max_message_size": 1048576,
        "retry_attempts": 3
    },
    "network": {
        "host": "0.0.0.0",
        "port": 8443,
        "keepalive_interval": 30
    },
    "logging": {
        "level": "INFO",
        "telemetry_enabled": true,
        "telemetry_file": "telemetry.log"
    }
}